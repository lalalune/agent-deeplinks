{
  "name": "agent-deeplinks",
  "version": "0.1.5",
  "description": "Evidence-backed deep links for AI agents with SVG icons and React helpers.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://agent-deeplinks.pages.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalune/agent-deeplinks.git"
  },
  "bugs": "https://github.com/lalalune/agent-deeplinks/issues",
  "keywords": [
    "agents",
    "deeplinks",
    "codex",
    "claude",
    "shadcn",
    "react"
  ],
  "files": [
    "dist",
    "icons"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./icons/*.svg": "./icons/*.svg",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:package && npm run build:site",
    "build:package": "node scripts/prepare-icons.mjs && tsc -p tsconfig.build.json",
    "build:site": "node scripts/prepare-icons.mjs && vite build",
    "dev": "node scripts/prepare-icons.mjs && vite",
    "check": "node scripts/prepare-icons.mjs && tsc --noEmit",
    "test": "npm run build:package && node --test test/*.test.mjs",
    "release:zip": "node scripts/release-zip.mjs",
    "prepack": "npm run build:package"
  },
  "peerDependencies": {
    "react": ">=18 <21"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0"
  }
}
